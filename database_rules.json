{
  "rules": {
    ".read": false,
    ".write": false,
    "chat": {
      "messages": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists() && (!root.child('users/'+auth.uid+'/hf').exists() || (query.orderByChild === 'timestamp' && query.startAt >= root.child('users/'+auth.uid+'/hf').val()))",
        ".indexOn": [
          "timestamp"
        ],
        "$messageId": {
          ".read": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists() && (!root.child('users/'+auth.uid+'/hf').exists() || data.child('timestamp').val() >= root.child('users/'+auth.uid+'/hf').val())",
          ".write": "(auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()) && ((!data.exists() && newData.child('senderUid').val() === auth.uid) || (data.child('senderUid').val() === auth.uid && ((data.exists() && !data.child('deleted').exists() && newData.hasChildren(['deleted','deletedAt']) && newData.child('text').val() === data.child('text').val() && newData.child('senderUid').val() === data.child('senderUid').val() && newData.child('senderName').val() === data.child('senderName').val() && newData.child('timestamp').val() === data.child('timestamp').val()) || (data.exists() && !data.child('deleted').exists() && newData.hasChildren(['edited','editedAt']) && now - data.child('timestamp').val() <= 1800000 && newData.child('editedAt').val() === now && newData.child('senderUid').val() === data.child('senderUid').val() && newData.child('senderName').val() === data.child('senderName').val() && newData.child('timestamp').val() === data.child('timestamp').val()))))",
          ".validate": "newData.hasChildren(['text','senderUid','senderName','timestamp'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
          },
          "senderUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val() === (data.exists() ? data.val() : auth.uid)"
          },
          "senderName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "timestamp": {
            ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
          },
          "replyTo": {
            ".validate": "newData.hasChildren(['key','sender','text'])",
            "key": {
              ".validate": "newData.isString()"
            },
            "sender": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "$other": {
              ".validate": false
            }
          },
          "deleted": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          },
          "deletedAt": {
            ".validate": "newData.val() === now"
          },
          "edited": {
            ".validate": "newData.isBoolean() && newData.val() === true"
          },
          "editedAt": {
            ".validate": "newData.val() === now"
          },
          "reactions": {
            ".write": false,
            ".validate": "data.exists()"
          },
          "react": {
            "$uid": {
              ".write": "(auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()) && $uid === auth.uid",
              ".validate": "newData.hasChildren(['emoji','name','ts'])",
              "emoji": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "ts": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "changes": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists() && (!root.child('users/'+auth.uid+'/hf').exists() || (query.orderByChild === 'ts' && query.startAt >= root.child('users/'+auth.uid+'/hf').val()))",
        ".indexOn": [
          "ts"
        ],
        "$cid": {
          ".write": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists() && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['k','t','ts','by']) && newData.child('by').val() === auth.uid && (newData.child('t').val() === 'd' || newData.child('t').val() === 'e' || newData.child('t').val() === 'r')",
          "k": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isString()"
          },
          "ts": {
            ".validate": "newData.val() === now"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "events": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()",
        ".indexOn": [
          "timestamp"
        ],
        "$eventId": {
          ".write": "(auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()) && !data.exists()",
          ".validate": "newData.hasChildren(['type','name','senderUid','timestamp']) && newData.child('type').val() === 'join'",
          "type": {
            ".validate": "newData.val() === 'join'"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "senderUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && newData.val() === auth.uid"
          },
          "timestamp": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "presence": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()",
        "$uid": {
          ".write": "(auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()) && $uid === auth.uid",
          ".validate": "newData.hasChildren(['name','online'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "lastSeen": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "push": {
        ".read": false,
        "$token": {
          ".write": "(auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()) && ((newData.exists() && newData.child('uid').val() === auth.uid) || (!newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['uid','name','mute','ts'])",
          "uid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "mute": {
            ".validate": "newData.val() === 'none' || newData.val() === 'normal' || newData.val() === 'all'"
          },
          "ts": {
            ".validate": true
          },
          "muteReact": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "typing": {
        ".read": "auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()",
        "$uid": {
          ".write": "(auth != null && auth.token.email_verified === true && root.child('users/'+auth.uid+'/usernameLower').exists()) && $uid === auth.uid",
          ".validate": "newData.hasChildren(['name','ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "ts": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "users": {
      ".read": "auth != null && auth.token.email_verified === true",
      "$uid": {
        ".write": "auth != null && auth.token.email_verified === true && auth.uid === $uid",
        ".validate": "newData.hasChildren(['displayName','username','usernameLower','joinedAt']) && (data.exists() || newData.child('hf').exists()) && (!data.child('hf').exists() || newData.child('hf').val() === data.child('hf').val())",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 20"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,20}$/) && newData.val().toLowerCase() === newData.parent().child('usernameLower').val()"
        },
        "usernameLower": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/) && (!data.exists() || newData.val() === data.val() || (newData.parent().child('usernameChangedAt').val() === now && (!data.parent().child('usernameChangedAt').exists() || now - data.parent().child('usernameChangedAt').val() >= 604800000)))"
        },
        "usernameChangedAt": {
          ".validate": "newData.val() === now || newData.val() === data.val()"
        },
        "joinedAt": {
          ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length <= 40000 && newData.val().beginsWith('data:image/')"
        },
        "updatedAt": {
          ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
        },
        "hf": {
          ".validate": "newData.val() === now || (data.exists() && newData.val() === data.val())"
        },
        "$other": {
          ".validate": false
        }
      },
      ".indexOn": [
        "updatedAt"
      ]
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "newData.isString() && $name.matches(/^[a-z0-9_]{3,20}$/)"
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$sid": {
          ".validate": "newData.hasChildren(['device','lastActive'])",
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "lastActive": {
            ".validate": true
          },
          "created": {
            ".validate": true
          },
          "revoked": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}